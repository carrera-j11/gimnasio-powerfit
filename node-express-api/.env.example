# ===== Servidor =====
PORT=3000

# ===== Base de datos MySQL =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gimnasio_node_db
DB_USER=root
DB_PASSWORD=root

# ===== JWT =====
JWT_SECRET=cambie_esto_por_una_clave_larga_y_aleatoria
JWT_EXPIRES_IN=1h

# ===== Correo (Gmail con contraseña de aplicación) =====
# Desde este correo se envía el código de verificación al email de cada usuario que se registra
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=TU_CORREO@gmail.com
SMTP_PASS=TU_CONTRASENA_DE_APLICACION

# Remitente del correo (opcional). Con Brevo: el correo verificado como remitente en Brevo
# MAIL_FROM=su_correo@gmail.com
# Alternativa si la red bloquea 465/587: Brevo por el puerto 2525
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=2525
# SMTP_USER=su_login@smtp-brevo.com
# SMTP_PASS=su_clave_smtp_de_brevo

# ===== Verificación de cuentas =====
CODIGO_MINUTOS_EXPIRACION=15
CODIGO_MAX_INTENTOS=5
# Plan B para la defensa: true = el código también se imprime en la consola
MOSTRAR_CODIGO_EN_CONSOLA=true

# ===== Administrador inicial =====
ADMIN_CEDULA=0100339076
ADMIN_NOMBRES=Administrador
ADMIN_APELLIDOS=General
ADMIN_EMAIL=admin@gimnasio.com
ADMIN_CELULAR=0999999999
ADMIN_PASSWORD=Admin123*

# ===== CORS: frontends que pueden consumir la API =====
CORS_ORIGENES=http://localhost:5173,http://localhost:4200
